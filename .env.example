APP_NAME="Phoenix Capital CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 / MariaDB (XAMPP default: root with empty password)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=phoenix_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@phoenixcapital.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dev-only seed credentials (change after first login)
ADMIN_NAME="Super Administrator"
ADMIN_EMAIL=admin@phoenixcapital.local
ADMIN_PASSWORD=ChangeMeNow!123

# Phase 3 — follow-ups / reminders / messaging stubs (never commit real secrets)
PHOENIX_UNCONTACTED_REMINDER_HOURS=24
PHOENIX_EMAIL_DRIVER="${MAIL_MAILER}"
PHOENIX_EMAIL_API_KEY=
PHOENIX_SMS_DRIVER=null
PHOENIX_SMS_API_KEY=
PHOENIX_SMS_USERNAME=
PHOENIX_SMS_SENDER_ID=

# Phase 4 — digital lead integrations (optional; prefer Admin → Integration settings)
# Without these, channels run in sandbox / pending-configuration mode.
PHOENIX_INTEGRATION_USER_EMAIL=integrations@phoenixcapital.local

# WhatsApp Business Cloud API (official Graph API only)
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Meta — Facebook Lead Ads + Messenger (official Graph API)
META_GRAPH_VERSION=v21.0
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=

# Instagram — supported Meta Messaging webhooks only
INSTAGRAM_GRAPH_VERSION=v21.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Website form embed
WEBSITE_LEADS_API_KEY=
WEBSITE_LEADS_RATE_LIMIT=30
